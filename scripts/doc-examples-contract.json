{
  "examples": [
    {
      "id": "server.cluster-info.curl",
      "path": "polyglot/server-api-reference.md",
      "language": "bash",
      "requiredSubstrings": [
        "curl -sS",
        "$DURABLE_WORKFLOW_SERVER_URL/api/cluster/info",
        "Authorization: Bearer $DURABLE_WORKFLOW_AUTH_TOKEN",
        "X-Namespace: default"
      ]
    },
    {
      "id": "server.workflow-start.curl",
      "path": "polyglot/server-api-reference.md",
      "language": "bash",
      "requiredSubstrings": [
        "curl -sS -X POST",
        "$DURABLE_WORKFLOW_SERVER_URL/api/workflows",
        "X-Durable-Workflow-Control-Plane-Version: 2",
        "\"workflow_type\": \"orders.fulfillment\"",
        "\"duplicate_policy\": \"reject\""
      ],
      "embeddedJsonAfter": "-d",
      "requiredJsonKeys": [
        "workflow_type",
        "workflow_id",
        "task_queue",
        "input",
        "memo",
        "search_attributes",
        "duplicate_policy"
      ]
    },
    {
      "id": "cli.workflow-task-history.command",
      "path": "polyglot/cli-reference.md",
      "language": "bash",
      "requiredSubstrings": [
        "dw workflow-task:history",
        "--lease-owner=python-worker-1",
        "--attempt=2",
        "--json"
      ]
    },
    {
      "id": "cli.workflow-task-history.response",
      "path": "polyglot/cli-reference.md",
      "language": "json",
      "requiredJsonKeys": [
        "history_events",
        "total_history_events",
        "next_history_page_token"
      ]
    },
    {
      "id": "python.quickstart.worker",
      "path": "polyglot/python.md",
      "language": "python",
      "requiredSubstrings": [
        "from durable_workflow import Client, Worker, workflow, activity",
        "@activity.defn(name=\"greet\")",
        "@workflow.defn(name=\"greeter\")",
        "await client.start_workflow(",
        "await worker.run_until(",
        "await handle.result("
      ]
    },
    {
      "id": "rust.workflow-start-timeouts",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "WorkflowStartOptions::new()",
        ".execution_timeout_seconds(300)",
        ".run_timeout_seconds(30)",
        "client.start_workflow_with_options(",
        "handle.workflow_id",
        "handle.run_id"
      ]
    },
    {
      "id": "rust.typed-workflow-timeouts",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "Error::WorkflowTimedOut(outcome)",
        "outcome.reason.as_str()",
        "outcome.failure_category.as_deref()",
        "result_wait_timeout",
        "client_timeout",
        "execution_timeout",
        "run_timeout",
        "outcome.workflow_id",
        "outcome.run_id"
      ]
    },
    {
      "id": "rust.avro-payload-envelope",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "PayloadEnvelope::avro(",
        "assert_eq!(envelope.codec, \"avro\")",
        "decode_payload(&envelope)"
      ]
    },
    {
      "id": "quickstart.laravel.install",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "composer create-project laravel/laravel durable-workflow-laravel-quickstart",
        "%%artifact.workflowComposerPackage%%",
        "%%artifact.waterlineComposerPackage%%",
        "composer show durable-workflow/workflow",
        "composer show durable-workflow/waterline",
        "QUEUE_CONNECTION=database",
        "WATERLINE_ALLOW_UNAUTHENTICATED=true",
        "php artisan waterline:install",
        "php artisan migrate"
      ]
    },
    {
      "id": "quickstart.laravel.workflow-files",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "cat > app/Workflows/Quickstart/WelcomeActivity.php",
        "#[Type('quickstart.laravel.welcome-activity')]",
        "return \"Hello, {$name}!\";",
        "cat > app/Workflows/Quickstart/WelcomeWorkflow.php",
        "#[Type('quickstart.laravel.welcome')]",
        "return activity(WelcomeActivity::class, $name);"
      ]
    },
    {
      "id": "quickstart.laravel.command",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "cat > app/Console/Commands/RunQuickstartWorkflow.php",
        "protected $signature = 'app:quickstart-workflow';",
        "$deadline = now()->addMinutes(10);",
        "$this->line('status='.$workflow->status());",
        "$this->line('output='.$workflow->output());"
      ]
    },
    {
      "id": "quickstart.laravel.run",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "php artisan queue:work --tries=1 --timeout=60",
        "storage/logs/quickstart-worker.log",
        "trap 'kill \"$QUICKSTART_QUEUE_PID\"",
        "SECONDS=0",
        "php artisan app:quickstart-workflow 2>&1 | tee quickstart-laravel-output.log",
        "printf 'elapsed_seconds=%s\\n' \"$SECONDS\"",
        "sed -n '1,120p' storage/logs/quickstart-worker.log"
      ]
    }
  ]
}
