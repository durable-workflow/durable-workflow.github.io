    {
      "id": "python.quickstart.worker",
      "path": "polyglot/python.md",
      "language": "python",
      "requiredSubstrings": [
        "from durable_workflow import Client, Worker, workflow, activity",
        "@activity.defn(name=\"greet\")",
        "@workflow.defn(name=\"greeter\")",
        "await client.start_workflow(",
        "await worker.run_until(",
        "await handle.result("
      ],
      "workflowIdentity": {
        "intent": "runnable_first_start",
        "generator": "python_uuid4_hex",
        "variable": "workflow_id",
        "references": [
          {
            "pattern": "\\bworkflow_id\\s*=\\s*workflow_id\\b",
            "minimum": 2
          }
        ]
      },
      "localConnection": {
        "hostingBranch": "standalone_server_sqlite",
        "shape": "python_client"
      }
    },
    {
      "id": "python.sync-client",
      "path": "polyglot/python.md",
      "language": "python",
      "workflowIdentity": {
        "intent": "runnable_first_start",
        "generator": "python_uuid4_hex",
        "variable": "workflow_id",
        "references": [
          {
            "pattern": "\\bworkflow_id\\s*=\\s*workflow_id\\b",
            "minimum": 1
          },
          {
            "pattern": "\\.describe_workflow\\(\\s*workflow_id\\b",
            "minimum": 1
          }
        ]
      }
    },
    {
      "id": "python.duplicate-start-recovery",
