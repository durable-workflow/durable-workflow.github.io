{
  "examples": [
    {
      "path": "deployment.md",
      "id": "single-region-failover-exact-release",
      "language": "bash",
      "requiredSubstrings": [
        "export DW_SERVER_RELEASE=%%artifact.serverVersion%%",
        "git clone --depth 1 --single-branch --branch \"$DW_SERVER_RELEASE\"",
        "https://github.com/durable-workflow/server.git \"server-$DW_SERVER_RELEASE\"",
        "cd \"server-$DW_SERVER_RELEASE\"",
        "export DW_SERVER_IMAGE=\"durableworkflow/server:$DW_SERVER_RELEASE\"",
        "scripts/conformance/single-region-failover-published-artifacts.sh"
      ]
    },
    {
      "id": "server.cluster-info.curl",
      "path": "polyglot/server-api-reference.md",
      "language": "bash",
      "requiredSubstrings": [
        "curl -sS",
        "$DURABLE_WORKFLOW_SERVER_URL/api/cluster/info",
        "Authorization: Bearer $DURABLE_WORKFLOW_AUTH_TOKEN",
        "X-Namespace: default"
      ]
    },
    {
      "id": "server.workflow-start.curl",
      "path": "polyglot/server-api-reference.md",
      "language": "bash",
      "requiredSubstrings": [
        "curl -sS -X POST",
        "$DURABLE_WORKFLOW_SERVER_URL/api/workflows",
        "X-Durable-Workflow-Control-Plane-Version: 2",
        "\"workflow_type\": \"orders.fulfillment\"",
        "\"duplicate_policy\": \"reject\""
      ],
      "embeddedJsonAfter": "-d",
      "requiredJsonKeys": [
        "workflow_type",
        "workflow_id",
        "task_queue",
        "input",
        "memo",
        "search_attributes",
        "duplicate_policy"
      ]
    },
    {
      "id": "cli.workflow-task-history.command",
      "path": "polyglot/cli-reference.md",
      "language": "bash",
      "requiredSubstrings": [
        "dw workflow-task:history",
        "--lease-owner=python-worker-1",
        "--attempt=2",
        "--json"
      ]
    },
    {
      "id": "cli.workflow-task-history.response",
      "path": "polyglot/cli-reference.md",
      "language": "json",
      "requiredJsonKeys": [
        "history_events",
        "total_history_events",
        "next_history_page_token"
      ]
    },
    {
      "id": "php.sdk.install",
      "path": "polyglot/php.md",
      "language": "bash",
      "publishedArtifactInstall": "sdk-php"
    },
    {
      "id": "server.php-sdk.install",
      "path": "polyglot/server.md",
      "language": "bash",
      "requiredSubstrings": [
        "composer require %%artifact.phpSdkComposerPackage%%"
      ]
    },
    {
      "id": "python.sdk.install",
      "path": "polyglot/python.md",
      "language": "bash",
      "primaryArtifactInstall": "sdk-python"
    },
    {
      "id": "python.quickstart.worker",
      "path": "polyglot/python.md",
      "language": "python",
      "requiredSubstrings": [
        "from durable_workflow import Client, Worker, workflow, activity",
        "@activity.defn(name=\"greet\")",
        "@workflow.defn(name=\"greeter\")",
        "await client.start_workflow(",
        "await worker.run_until(",
        "await handle.result("
      ],
      "workflowIdentity": {
        "intent": "runnable_first_start",
        "generator": "python_uuid4_hex",
        "variable": "workflow_id",
        "references": [
          {
            "pattern": "\\bworkflow_id\\s*=\\s*workflow_id\\b",
            "minimum": 2
          }
        ]
      },
      "localConnection": {
        "hostingBranch": "standalone_server_sqlite",
        "shape": "python_client"
      }
    },
    {
      "id": "python.sync-client",
      "path": "polyglot/python.md",
      "language": "python",
      "workflowIdentity": {
        "intent": "runnable_first_start",
        "generator": "python_uuid4_hex",
        "variable": "workflow_id",
        "references": [
          {
            "pattern": "\\bworkflow_id\\s*=\\s*workflow_id\\b",
            "minimum": 1
          },
          {
            "pattern": "\\.describe_workflow\\(\\s*workflow_id\\b",
            "minimum": 1
          }
        ]
      }
    },
    {
      "id": "python.duplicate-start-recovery",
      "path": "polyglot/python.md",
      "language": "python",
      "workflowIdentity": {
        "intent": "intentional_fixed_semantics",
        "fixedId": "existing-id",
        "minimumOccurrences": 2
      }
    },
    {
      "id": "rust.sdk.install",
      "path": "polyglot/rust.md",
      "language": "bash",
      "primaryArtifactInstall": "sdk-rust"
    },
    {
      "id": "rust.sdk.repository-source",
      "path": "polyglot/rust.md",
      "language": "bash",
      "releasedRepositorySetup": {
        "artifact": "sdk-rust",
        "repositoryUrl": "https://github.com/durable-workflow/sdk-rust.git",
        "versionEnvironment": "DURABLE_WORKFLOW_RUST_VERSION",
        "directoryEnvironment": "DURABLE_WORKFLOW_RUST_EXAMPLE_DIR",
        "directoryTemplate": "$PWD/durable-workflow-rust-${DURABLE_WORKFLOW_RUST_VERSION}"
      }
    },
    {
      "id": "rust.sdk.cloud.environment",
      "path": "polyglot/rust.md",
      "language": "bash",
      "requiredSubstrings": [
        "DURABLE_WORKFLOW_RUNTIME_URL",
        "DURABLE_WORKFLOW_RUNTIME_NAMESPACE",
        "DURABLE_WORKFLOW_CLIENT_TOKEN",
        "DURABLE_WORKFLOW_WORKER_TOKEN"
      ]
    },
    {
      "id": "rust.sdk.cloud.client",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "DURABLE_WORKFLOW_RUNTIME_URL",
        "DURABLE_WORKFLOW_RUNTIME_NAMESPACE",
        "DURABLE_WORKFLOW_CLIENT_TOKEN",
        "DURABLE_WORKFLOW_WORKER_TOKEN",
        ".control_token(Some(client_token))",
        ".worker_token(Some(worker_token))"
      ]
    },
    {
      "id": "rust.sdk.cloud.run",
      "path": "polyglot/rust.md",
      "language": "bash",
      "repositoryExampleInvocation": {
        "setupExample": "rust.sdk.repository-source",
        "workingDirectoryEnvironment": "DURABLE_WORKFLOW_RUST_EXAMPLE_DIR",
        "command": "cargo run --example hello_world"
      }
    },
    {
      "id": "rust.sdk.self-hosted",
      "path": "polyglot/rust.md",
      "language": "bash",
      "repositoryExampleInvocation": {
        "setupExample": "rust.sdk.repository-source",
        "workingDirectoryEnvironment": "DURABLE_WORKFLOW_RUST_EXAMPLE_DIR",
        "command": "cargo run --example hello_world"
      },
      "localConnection": {
        "hostingBranch": "standalone_server_sqlite",
        "shape": "rust_hello_world_environment"
      }
    },
    {
      "id": "rust.workflow-start-timeouts",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "WorkflowStartOptions::new()",
        ".execution_timeout_seconds(300)",
        ".run_timeout_seconds(30)",
        "client.start_workflow_with_options(",
        "handle.workflow_id",
        "handle.run_id"
      ]
    },
    {
      "id": "rust.typed-workflow-timeouts",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "Error::WorkflowTimedOut(outcome)",
        "outcome.reason.as_str()",
        "outcome.failure_category.as_deref()",
        "result_wait_timeout",
        "client_timeout",
        "execution_timeout",
        "run_timeout",
        "outcome.workflow_id",
        "outcome.run_id"
      ]
    },
    {
      "id": "rust.avro-payload-envelope",
      "path": "polyglot/rust.md",
      "language": "rust",
      "requiredSubstrings": [
        "PayloadEnvelope::avro(",
        "assert_eq!(envelope.codec, \"avro\")",
        "decode_payload(&envelope)"
      ]
    },
    {
      "id": "quickstart.server.setup",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "export DW_SERVER_IMAGE=%%artifact.serverDockerHubImage%%",
        "server-bootstrap",
        "http://localhost:8080/api/ready",
        "http://localhost:8080/api/cluster/info"
      ]
    },
    {
      "id": "quickstart.php.install",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "composer require %%artifact.phpSdkComposerPackage%%"
      ]
    },
    {
      "id": "quickstart.php.worker",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "use DurableWorkflow\\Worker;",
        "$worker->registerActivity(",
        "$worker->registerWorkflow(",
        "$worker->run();"
      ]
    },
    {
      "id": "quickstart.php.client",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "$client->startWorkflow(",
        "$handle->result(",
        "$handle->describeSelectedRun()",
        "status={$execution->status}"
      ]
    },
    {
      "id": "quickstart.python.greeter",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "from durable_workflow import Client, Worker, activity, workflow",
        "await worker.run_until(",
        "await handle.result(",
        "await handle.describe_run()"
      ]
    },
    {
      "id": "quickstart.rust.install",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "%%artifact.rustCargoAddCommand%%"
      ]
    },
    {
      "id": "quickstart.rust.greeter",
      "path": "quickstart.md",
      "language": "bash",
      "requiredSubstrings": [
        "Worker::new(",
        "worker.register_activity(",
        "worker.register_workflow(",
