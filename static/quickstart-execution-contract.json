    {
      "id": "standalone_server_sqlite",
      "label": "Standalone server with SQLite",
      "used_by_personas": [
        "php",
        "python",
        "rust",
        "operator"
      ],
      "clean_directory_required": true,
      "required_environment": [
        {
          "name": "DW_SERVER_IMAGE",
          "value": "durableworkflow/server:0.2.656"
        },
        {
          "name": "DW_AUTH_TOKEN",
          "value": "dev-token"
        }
      ],
      "required_ports": [
        {
          "host": 8080,
          "container": 8080,
          "protocol": "tcp"
        }
      ],
      "docs_examples": [
        "quickstart.server.setup"
      ],
      "setup_script_lines": [
        "export DW_SERVER_IMAGE=durableworkflow/server:0.2.656",
        "export DW_AUTH_TOKEN=dev-token",
        "",
        "docker volume create durable-workflow-quickstart",
        "",
        "docker run --rm \\",
        "  -v durable-workflow-quickstart:/app/database \\",
        "  -e DW_AUTH_DRIVER=token \\",
        "  -e DW_AUTH_TOKEN=\"$DW_AUTH_TOKEN\" \\",
        "  \"$DW_SERVER_IMAGE\" server-bootstrap",
        "",
        "docker rm -f durable-workflow-server >/dev/null 2>&1 || true",
        "docker run -d --name durable-workflow-server \\",
        "  -p 8080:8080 \\",
        "  -v durable-workflow-quickstart:/app/database \\",
        "  -e DW_AUTH_DRIVER=token \\",
        "  -e DW_AUTH_TOKEN=\"$DW_AUTH_TOKEN\" \\",
        "  \"$DW_SERVER_IMAGE\"",
        "",
        "until curl -sf http://localhost:8080/api/ready >/dev/null; do sleep 1; done",
        "curl -H \"Authorization: Bearer $DW_AUTH_TOKEN\" \\",
        "  http://localhost:8080/api/cluster/info"
      ],
      "success_probes": [
        {
          "id": "ready_endpoint",
          "command": "curl -sf http://localhost:8080/api/ready",
          "expect_exit_code": 0
        },
        {
          "id": "cluster_info_endpoint",
          "command": "curl -H \"Authorization: Bearer $DW_AUTH_TOKEN\" http://localhost:8080/api/cluster/info",
          "expect_exit_code": 0,
          "expect_json": true
        }
      ],
      "teardown_script_lines": [
        "docker rm -f durable-workflow-server",
        "docker volume rm durable-workflow-quickstart"
      ]
    },
