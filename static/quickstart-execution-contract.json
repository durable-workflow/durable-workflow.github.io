  "scenarios": [
    {
      "id": "php_user_local_server_completion",
      "persona": "php",
      "hosting_branch": "standalone_server_sqlite",
      "depends_on": [
        "standalone_server_sqlite"
      ],
      "source_channels": [
        "docker_hub",
        "packagist"
      ],
      "working_directory": "clean parent directory",
      "required_environment": [
        {
          "name": "DW_AUTH_TOKEN",
          "value": "dev-token"
        }
      ],
      "docs_examples": [
        "quickstart.php.install",
        "quickstart.php.worker",
        "quickstart.php.client",
        "quickstart.php.run"
      ],
      "command_script_lines": [
        "mkdir durable-workflow-php-quickstart",
        "cd durable-workflow-php-quickstart",
        "composer require durable-workflow/sdk:0.1.4",
        "cat > worker.php <<'PHP'",
        "<?php",
        "",
        "declare(strict_types=1);",
        "",
        "require __DIR__.'/vendor/autoload.php';",
        "",
        "use DurableWorkflow\\Client;",
        "use DurableWorkflow\\Worker;",
        "use DurableWorkflow\\Worker\\ActivityContext;",
        "use DurableWorkflow\\Worker\\WorkflowContext;",
        "",
        "$client = new Client('http://localhost:8080', token: 'dev-token');",
        "$worker = new Worker($client, 'quickstart-php');",
        "",
        "$worker->registerActivity(",
        "    'quickstart.greet',",
        "    static fn (ActivityContext $context, string $name): string => \"Hello, {$name}!\",",
        ");",
        "",
        "$worker->registerWorkflow(",
        "    'quickstart.greeter',",
        "    static function (WorkflowContext $context, string $name): Generator {",
        "        $greeting = yield $context->activity('quickstart.greet', [$name]);",
        "",
        "        return ['greeting' => $greeting, 'language' => 'php'];",
        "    },",
        ");",
        "",
        "$worker->run();",
        "PHP",
        "cat > start.php <<'PHP'",
        "<?php",
        "",
        "declare(strict_types=1);",
        "",
        "require __DIR__.'/vendor/autoload.php';",
        "",
        "use DurableWorkflow\\Client;",
        "",
        "$client = new Client('http://localhost:8080', token: 'dev-token');",
        "$workflowId = 'quickstart-php-greeter-'.bin2hex(random_bytes(4));",
        "$handle = $client->startWorkflow(",
        "    workflowType: 'quickstart.greeter',",
        "    workflowId: $workflowId,",
        "    taskQueue: 'quickstart-php',",
        "    input: ['PHP'],",
        ");",
        "",
        "$result = $handle->result(timeoutSeconds: 30);",
        "$execution = $handle->describeSelectedRun();",
        "",
        "echo \"workflow_id={$execution->workflowId}\\n\";",
        "echo \"status={$execution->status}\\n\";",
        "echo 'result='.json_encode($result, JSON_THROW_ON_ERROR).\"\\n\";",
        "PHP",
        "php worker.php > quickstart-worker.log 2>&1 &",
        "export QUICKSTART_WORKER_PID=$!",
        "trap 'kill \"$QUICKSTART_WORKER_PID\" 2>/dev/null || true' EXIT",
        "",
        "php start.php",
        "",
        "kill \"$QUICKSTART_WORKER_PID\" 2>/dev/null || true",
        "trap - EXIT"
      ],
      "success_probes": [
        {
          "id": "php_output_status",
          "source": "stdout",
          "required_substrings": [
            "workflow_id=quickstart-php-greeter-",
            "status=completed",
            "Hello, PHP!"
          ]
        },
        {
          "id": "php_official_avro_package",
          "command": "composer show apache/avro",
          "expect_exit_code": 0
        }
      ],
      "expected_completion_state": {
        "workflow_id_pattern": "^quickstart-php-greeter-[a-f0-9]{8}$",
        "status": "completed",
        "result_contains": "Hello, PHP!",
        "timeout_seconds": 60
      },
      "teardown_script_lines": [
        "kill \"$QUICKSTART_WORKER_PID\" 2>/dev/null || true",
        "cd ..",
        "rm -rf durable-workflow-php-quickstart"
      ]
    },
    {
      "id": "python_user_local_server_completion",
      "persona": "python",
      "hosting_branch": "standalone_server_sqlite",
      "depends_on": [
        "standalone_server_sqlite"
      ],
      "source_channels": [
        "docker_hub",
        "pypi"
      ],
      "working_directory": "clean parent directory",
      "required_environment": [
        {
          "name": "DW_AUTH_TOKEN",
          "value": "dev-token"
        }
      ],
      "docs_examples": [
        "quickstart.python.install",
        "quickstart.python.greeter"
      ],
      "command_script_lines": [
        "mkdir durable-workflow-python-quickstart",
        "cd durable-workflow-python-quickstart",
        "",
        "python3 -m venv .venv",
        ". .venv/bin/activate",
        "pip install durable-workflow==0.4.99",
        "cat > greeter.py <<'PY'",
        "import asyncio",
        "import time",
        "",
        "from durable_workflow import Client, Worker, activity, workflow",
        "",
        "",
        "@activity.defn(name=\"quickstart.greet\")",
        "async def greet(name: str) -> dict:",
        "    return {\"greeting\": f\"Hello, {name}!\", \"language\": \"python\"}",
        "",
        "",
        "@workflow.defn(name=\"quickstart.greeter\")",
        "class GreeterWorkflow:",
        "    def run(self, ctx, name):",
        "        return (yield ctx.schedule_activity(\"quickstart.greet\", [name]))",
        "",
        "",
        "async def main():",
        "    workflow_id = f\"quickstart-python-greeter-{int(time.time())}\"",
        "",
        "    async with Client(",
        "        \"http://localhost:8080\",",
        "        token=\"dev-token\",",
        "        namespace=\"default\",",
        "    ) as client:",
        "        handle = await client.start_workflow(",
        "            workflow_type=\"quickstart.greeter\",",
        "            task_queue=\"quickstart-python\",",
        "            workflow_id=workflow_id,",
        "            input=[\"Python\"],",
        "        )",
        "",
        "        worker = Worker(",
        "            client,",
        "            task_queue=\"quickstart-python\",",
        "            workflows=[GreeterWorkflow],",
        "            activities=[greet],",
        "        )",
        "        await worker.run_until(workflow_id=workflow_id, timeout=30.0)",
        "",
        "        result = await handle.result(timeout=10.0)",
        "        execution = await handle.describe_run()",
        "",
        "    print(f\"workflow_id={execution.workflow_id}\")",
        "    print(f\"status={execution.status}\")",
        "    print(f\"result={result}\")",
        "",
        "",
        "asyncio.run(main())",
        "PY",
        "",
        "python greeter.py"
      ],
      "success_probes": [
        {
          "id": "python_output_status",
          "source": "stdout",
          "required_substrings": [
            "workflow_id=quickstart-python-greeter-",
            "status=completed",
            "Hello, Python!"
          ]
        },
        {
          "id": "python_official_avro_package",
          "command": "pip show avro",
          "expect_exit_code": 0
        }
      ],
      "expected_completion_state": {
        "workflow_id_pattern": "^quickstart-python-greeter-[0-9]+$",
        "status": "completed",
        "result_contains": "Hello, Python!",
        "timeout_seconds": 60
      },
      "outputs_for_dependent_scenarios": [
        {
          "name": "QUICKSTART_WORKFLOW_ID",
          "source": "stdout.workflow_id"
        }
      ],
      "teardown_script_lines": [
        "deactivate 2>/dev/null || true",
        "cd ..",
        "rm -rf durable-workflow-python-quickstart"
      ]
    },
    {
      "id": "rust_user_local_server_completion",
      "persona": "rust",
      "hosting_branch": "standalone_server_sqlite",
      "depends_on": [
        "standalone_server_sqlite"
      ],
      "source_channels": [
        "docker_hub",
        "crates_io"
      ],
      "working_directory": "clean parent directory",
      "required_environment": [
        {
          "name": "DW_AUTH_TOKEN",
          "value": "dev-token"
        }
      ],
      "docs_examples": [
        "quickstart.rust.install",
        "quickstart.rust.greeter"
      ],
      "command_script_lines": [
        "cargo new durable-workflow-rust-quickstart",
        "cd durable-workflow-rust-quickstart",
        "cargo add durable-workflow@=0.1.15",
        "cargo add tokio --features macros,rt-multi-thread,time",
        "cat > src/main.rs <<'RS'",
        "use std::time::{Duration, SystemTime, UNIX_EPOCH};",
        "",
        "use durable_workflow::{json, Client, Result, Worker, WorkflowResultOptions};",
        "",
        "#[tokio::main]",
        "async fn main() -> Result<()> {",
        "    let client = Client::builder(\"http://localhost:8080\")",
        "        .token(Some(\"dev-token\".to_string()))",
        "        .namespace(\"default\")",
        "        .build()?;",
        "    let task_queue = \"quickstart-rust\";",
        "    let mut worker = Worker::new(client.clone(), task_queue);",
        "",
        "    worker.register_activity(\"quickstart.greet\", |_context, arguments| async move {",
        "        let name = arguments",
        "            .get(0)",
        "            .and_then(|value| value.as_str())",
        "            .unwrap_or(\"Rust\");",
        "        Ok(json!({\"greeting\": format!(\"Hello, {name}!\"), \"language\": \"rust\"}))",
        "    });",
        "",
        "    worker.register_workflow(\"quickstart.greeter\", |context, input| async move {",
        "        let name = input.get(0).and_then(|value| value.as_str()).unwrap_or(\"Rust\");",
        "        context.activity(\"quickstart.greet\", json!([name])).await",
        "    });",
        "",
        "    worker.register().await?;",
        "    let workflow_id = format!(\"quickstart-rust-greeter-{}\", unique_suffix());",
        "    let handle = client",
        "        .start_workflow(",
        "            \"quickstart.greeter\",",
        "            task_queue,",
        "            &workflow_id,",
        "            json!([\"Rust\"]),",
        "        )",
        "        .await?;",
        "",
        "    let watcher = handle.clone();",
        "    worker",
        "        .run_until(async move {",
        "            loop {",
        "                if watcher.describe().await.is_ok_and(|run| run.is_terminal()) {",
        "                    break;",
        "                }",
        "                tokio::time::sleep(Duration::from_millis(500)).await;",
        "            }",
        "        })",
        "        .await?;",
        "",
        "    let result = handle.result(WorkflowResultOptions::default()).await?;",
        "    let execution = handle.describe_selected_run().await?;",
        "",
        "    println!(\"workflow_id={workflow_id}\");",
        "    println!(\"status={}\", execution.status.as_deref().unwrap_or(\"unknown\"));",
        "    println!(\"result={result}\");",
        "    Ok(())",
        "}",
        "",
        "fn unique_suffix() -> u128 {",
        "    SystemTime::now()",
        "        .duration_since(UNIX_EPOCH)",
        "        .unwrap_or_default()",
        "        .as_millis()",
        "}",
        "RS",
        "",
        "cargo run"
      ],
      "success_probes": [
        {
          "id": "rust_output_status",
          "source": "stdout",
          "required_substrings": [
            "workflow_id=quickstart-rust-greeter-",
            "status=completed",
            "Hello, Rust!"
          ]
        },
        {
          "id": "rust_official_avro_package",
          "command": "cargo tree -i apache-avro",
          "expect_exit_code": 0
        }
      ],
      "expected_completion_state": {
        "workflow_id_pattern": "^quickstart-rust-greeter-[0-9]+$",
        "status": "completed",
        "result_contains": "Hello, Rust!",
        "timeout_seconds": 180
      },
      "teardown_script_lines": [
        "cd ..",
        "rm -rf durable-workflow-rust-quickstart"
      ]
    },
    {
      "id": "operator_local_server_observation",
      "persona": "operator",
      "hosting_branch": "standalone_server_sqlite",
      "depends_on": [
        "standalone_server_sqlite",
        "python_user_local_server_completion"
      ],
      "source_channels": [
        "durable_workflow_public_installer",
        "docker_hub"
      ],
      "working_directory": "same clean parent directory used for the standalone server",
      "required_environment": [
        {
          "name": "QUICKSTART_WORKFLOW_ID",
          "source": "python_user_local_server_completion.stdout.workflow_id",
          "example": "quickstart-python-greeter-0000000000"
        }
      ],
      "command_script_lines": [
        "curl -fsSL https://durable-workflow.com/install.sh | VERSION=0.1.90 sh",
        "export PATH=\"$HOME/.local/bin:$PATH\"",
        "",
        "dw env:set local \\",
        "  --server=http://localhost:8080 \\",
        "  --token=dev-token \\",
        "  --namespace=default \\",
        "  --make-default",
        "",
        "dw doctor",
        "dw server:health",
        "dw server:info --output=json",
        "export QUICKSTART_WORKFLOW_ID=\"${QUICKSTART_WORKFLOW_ID:?set to workflow_id printed by python greeter.py}\"",
        "",
        "dw workflow:describe \"$QUICKSTART_WORKFLOW_ID\" --output=json \\",
        "  | tee quickstart-workflow.json",
        "export QUICKSTART_RUN_ID=\"$(",
        "  python -c 'import json; print(json.load(open(\"quickstart-workflow.json\"))[\"run_id\"])'",
        ")\"",
        "",
        "dw workflow:history \"$QUICKSTART_WORKFLOW_ID\" \"$QUICKSTART_RUN_ID\" --output=json",
        "dw workflow:list --status=completed --output=json"
      ],
      "success_probes": [
        {
          "id": "doctor",
          "command": "dw doctor",
          "expect_exit_code": 0
        },
        {
          "id": "server_health",
          "command": "dw server:health",
          "expect_exit_code": 0
        },
        {
          "id": "describe_has_run_id",
          "source": "quickstart-workflow.json",
          "expect_json_key": "run_id"
        },
        {
          "id": "completed_list_contains_workflow",
          "source": "stdout",
          "required_substrings": [
            "quickstart-python-greeter-"
          ]
        }
      ],
      "expected_completion_state": {
        "observes_workflow_from": "python_user_local_server_completion",
        "status": "completed",
        "operator_only_creates_workflow": false
      },
      "teardown_script_lines": [
        "dw env:delete local || true",
        "rm -f quickstart-workflow.json"
      ]
    },
    {
      "id": "laravel_user_embedded_completion",
      "persona": "laravel",
      "hosting_branch": "embedded_laravel_database_queue",
      "depends_on": [],
      "source_channels": [
        "packagist"
      ],
      "working_directory": "clean parent directory",
      "required_environment": [
        {
          "name": "QUEUE_CONNECTION",
          "value": "database"
        },
        {
          "name": "WATERLINE_ALLOW_UNAUTHENTICATED",
          "value": "true"
        }
      ],
      "command_script_lines": [
        "composer create-project laravel/laravel durable-workflow-laravel-quickstart",
        "cd durable-workflow-laravel-quickstart",
        "",
        "composer require \\",
        "  durable-workflow/workflow:2.0.0-alpha.280@alpha \\",
        "  durable-workflow/waterline:2.0.0-alpha.132@alpha",
        "composer show durable-workflow/workflow",
        "composer show durable-workflow/waterline",
        "",
        "printf '\\nQUEUE_CONNECTION=database\\nWATERLINE_ALLOW_UNAUTHENTICATED=true\\n' >> .env",
        "php artisan key:generate",
        "php artisan waterline:install",
        "php artisan migrate",
        "mkdir -p app/Workflows/Quickstart",
        "",
        "cat > app/Workflows/Quickstart/WelcomeActivity.php <<'PHP'",
        "<?php",
        "",
        "namespace App\\Workflows\\Quickstart;",
        "",
        "use Workflow\\V2\\Activity;",
        "use Workflow\\V2\\Attributes\\Type;",
        "",
        "#[Type('quickstart.laravel.welcome-activity')]",
        "class WelcomeActivity extends Activity",
        "{",
        "    public function handle(string $name): string",
        "    {",
        "        return \"Hello, {$name}!\";",
        "    }",
        "}",
        "PHP",
        "",
        "cat > app/Workflows/Quickstart/WelcomeWorkflow.php <<'PHP'",
        "<?php",
        "",
        "namespace App\\Workflows\\Quickstart;",
        "",
        "use Workflow\\V2\\Attributes\\Type;",
        "use Workflow\\V2\\Workflow;",
        "",
        "use function Workflow\\V2\\activity;",
        "",
        "#[Type('quickstart.laravel.welcome')]",
        "class WelcomeWorkflow extends Workflow",
        "{",
        "    public function handle(string $name): string",
        "    {",
        "        return activity(WelcomeActivity::class, $name);",
        "    }",
        "}",
        "PHP",
        "mkdir -p app/Console/Commands",
        "",
        "cat > app/Console/Commands/RunQuickstartWorkflow.php <<'PHP'",
        "<?php",
        "",
        "namespace App\\Console\\Commands;",
        "",
        "use App\\Workflows\\Quickstart\\WelcomeWorkflow;",
        "use Illuminate\\Console\\Command;",
        "use Workflow\\V2\\WorkflowStub;",
        "",
        "class RunQuickstartWorkflow extends Command",
        "{",
        "    protected $signature = 'app:quickstart-workflow';",
        "",
        "    protected $description = 'Run the Durable Workflow quickstart workflow.';",
        "",
        "    public function handle(): int",
        "    {",
        "        $workflow = WorkflowStub::make(",
        "            WelcomeWorkflow::class,",
        "            'quickstart-laravel-'.now()->format('YmdHis')",
        "        );",
        "",
        "        $workflow->start('Laravel');",
        "        $deadline = now()->addMinutes(10);",
        "",
        "        while ($workflow->refresh()->running()) {",
        "            if (now()->greaterThan($deadline)) {",
        "                $this->error('status=timeout');",
        "                $this->line('workflow_id='.$workflow->workflowId());",
        "",
        "                return self::FAILURE;",
        "            }",
        "",
        "            usleep(100_000);",
        "        }",
        "",
        "        $this->line('workflow_id='.$workflow->workflowId());",
        "        $this->line('status='.$workflow->status());",
        "        $this->line('output='.$workflow->output());",
        "",
        "        return $workflow->completed() ? self::SUCCESS : self::FAILURE;",
        "    }",
        "}",
        "PHP",
        "set -o pipefail",
        "",
        "php artisan queue:work --tries=1 --timeout=60 \\",
        "  > storage/logs/quickstart-worker.log 2>&1 &",
        "export QUICKSTART_QUEUE_PID=$!",
        "trap 'kill \"$QUICKSTART_QUEUE_PID\" 2>/dev/null || true' EXIT",
        "",
        "SECONDS=0",
        "php artisan app:quickstart-workflow 2>&1 | tee quickstart-laravel-output.log",
        "printf 'elapsed_seconds=%s\\n' \"$SECONDS\"",
        "",
        "if [ -s storage/logs/quickstart-worker.log ]; then",
        "  sed -n '1,120p' storage/logs/quickstart-worker.log",
        "fi",
        "",
        "kill \"$QUICKSTART_QUEUE_PID\" 2>/dev/null || true",
        "trap - EXIT"
      ],
      "success_probes": [
        {
          "id": "composer_workflow_version",
          "source": "stdout",
          "required_substrings": [
            "durable-workflow/workflow",
            "2.0.0-alpha.280"
          ]
        },
        {
          "id": "composer_waterline_version",
          "source": "stdout",
          "required_substrings": [
            "durable-workflow/waterline",
            "2.0.0-alpha.132"
          ]
        },
        {
          "id": "artisan_completion",
          "source": "quickstart-laravel-output.log",
          "required_substrings": [
            "status=completed",
            "output=Hello, Laravel!"
          ]
        },
        {
          "id": "elapsed_time_recorded",
          "source": "stdout",
          "required_substrings": [
            "elapsed_seconds="
          ]
        }
      ],
      "expected_completion_state": {
        "workflow_id_pattern": "^quickstart-laravel-[0-9]{14}$",
        "status": "completed",
        "result_contains": "Hello, Laravel!",
        "timeout_seconds": 600
      },
      "teardown_script_lines": [
        "kill \"$QUICKSTART_QUEUE_PID\" 2>/dev/null || true",
        "cd ..",
        "rm -rf durable-workflow-laravel-quickstart"
      ]
    }
  ]
}
