    "message": "Entwickeln Sie mit PHP, Python oder Rust"
  },
  "homepage.features.languages.description": {
    "message": "Erstellen Sie Clients, Workflows und Aktivitäten mit den offiziellen SDKs. Nutzen Sie ein gemeinsames öffentliches Protokoll und ein sprachübergreifendes Avro-Format."
  },
  "homepage.features.runtime.title": {
    "message": "Wählen Sie, wer die Laufzeitumgebung betreibt"
  },
  "homepage.features.runtime.description": {
    "message": "Nutzen Sie Durable Workflow Cloud, betreiben Sie einen eigenen Server oder betten Sie die Laufzeitumgebung in Ihre Laravel-Anwendung ein."
  },
  "homepage.features.recovery.title": {
    "message": "Nach einem Ausfall fortsetzen"
  },
  "homepage.features.recovery.description": {
    "message": "Dauerhafte Historie, deterministisches Replay, Timer, Wiederholungsversuche, Signale, Updates, untergeordnete Workflows und Sagas für lang laufende Prozesse."
