  "homepage.description": {
    "message": "Eine Plattform für dauerhafte Ausführung in PHP, Python und Rust. Verwaltete Cloud, selbst betriebener Server oder Einbettung in Laravel."
  },
  "homepage.cloudDescription": {
    "message": "Führen Sie PHP-, Python- und Rust-Worker in einem verwalteten Namespace aus. Durable Workflow übernimmt die Orchestrierung und den Betrieb der Laufzeitumgebung."
  },
